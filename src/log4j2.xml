<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout disableAnsi="false" noConsoleNoAnsi="false"
                pattern="[%d{HH:mm:ss}] [%t/%highlight{%-4level}{FATAL=red bold, ERROR=red, WARN=yellow, INFO=cyan, DEBUG=white, TRACE=cyan}]: %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
